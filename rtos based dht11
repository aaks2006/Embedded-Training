
#include <Arduino.h>
#include <DHT.h>

// Pin configuration
#define DHT_PIN 4
#define BUZZER_PIN 25
#define DHT_TYPE DHT11

// Temperature thresholds
const float ON_TEMP = 30.0;
const float OFF_TEMP = 29.0;

// Sensor data structure
struct SensorData {
  float temp;
  float humidity;
};

// DHT11 object
DHT dht(DHT_PIN, DHT_TYPE);

// FreeRTOS queues
QueueHandle_t displayQueue;
QueueHandle_t alertQueue;

// Task 1: Read sensor and send data
void sensorTask(void *p) {
  SensorData d;

  while (true) {
    d.temp = dht.readTemperature();
    d.humidity = dht.readHumidity();

    if (!isnan(d.temp) && !isnan(d.humidity)) {
      xQueueOverwrite(displayQueue, &d);
      xQueueOverwrite(alertQueue, &d);
    }

    // Wait 2.5 seconds
    vTaskDelay(pdMS_TO_TICKS(2500));
  }
}

// Task 2: Display sensor readings
void displayTask(void *p) {
  SensorData d;

  while (true) {
    if (xQueueReceive(displayQueue, &d, portMAX_DELAY) == pdTRUE) {
      Serial.print("Temp: ");
      Serial.print(d.temp);
      Serial.print(" C | Hum: ");
      Serial.println(d.humidity);
    }
  }
}

// Task 3: Control the buzzer
void alertTask(void *p) {
  SensorData d;
  bool alarm = false;

  while (true) {
    if (xQueueReceive(alertQueue, &d, portMAX_DELAY) == pdTRUE) {
      if (d.temp > ON_TEMP) {
        alarm = true;
      }

      if (d.temp < OFF_TEMP) {
        alarm = false;
      }

      digitalWrite(BUZZER_PIN, alarm ? HIGH : LOW);
    }
  }
}

// Setup
void setup() {
  Serial.begin(115200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  dht.begin();

  // Create queues (one SensorData item each)
  displayQueue = xQueueCreate(1, sizeof(SensorData));
  alertQueue = xQueueCreate(1, sizeof(SensorData));

  // Check whether queue creation succeeded
  if (displayQueue == NULL || alertQueue == NULL) {
    Serial.println("Queue creation failed!");
    while (true) {
      delay(1000);
    }
  }

  // Create FreeRTOS tasks
  xTaskCreate(sensorTask, "Sensor", 4096, NULL, 2, NULL);
  xTaskCreate(displayTask, "Display", 3072, NULL, 1, NULL);
  xTaskCreate(alertTask, "Alert", 3072, NULL, 3, NULL);
}

void loop() {
  vTaskDelay(pdMS_TO_TICKS(1000));
}
