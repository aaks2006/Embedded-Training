#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>

#define TFT_CS    5
#define TFT_DC    25
#define TFT_RST   13
#define TFT_SCLK  18
#define TFT_MOSI  23

Adafruit_ST7735 tft(TFT_CS, TFT_DC, TFT_RST);

#define TOUCH_PIN 4

#define BUZZER_PIN 26

bool previousAlert = false;

void showSecure() {
  tft.fillScreen(ST77XX_BLACK);

  tft.setTextColor(ST77XX_GREEN);
  tft.setTextSize(2);
  tft.setCursor(10, 30);
  tft.println("SYSTEM");
  tft.setCursor(10, 60);
  tft.println("SECURE");

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(1);
  tft.setCursor(20, 100);
  tft.println("Monitoring...");

  digitalWrite(BUZZER_PIN, LOW);
}

void showAlert() {
  tft.fillScreen(ST77XX_RED);

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 30);
  tft.println("SECURITY");
  tft.setCursor(10, 60);
  tft.println("ALERT!");

  tft.setTextSize(1);
  tft.setCursor(20, 100);
  tft.println("TOUCH DETECTED");

  digitalWrite(BUZZER_PIN, HIGH);
}

void setup() {
  Serial.begin(115200);

  pinMode(TOUCH_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  SPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);

  tft.initR(INITR_BLACKTAB);
  tft.setRotation(1);

  showSecure();
}

void loop() {
  int touchState = digitalRead(TOUCH_PIN);

  bool alert = (touchState == HIGH);

  if (alert != previousAlert) {
    previousAlert = alert;

    if (alert) {
      showAlert();
      Serial.println("SECURITY ALERT");
    } else {
      showSecure();
      Serial.println("SYSTEM SECURE");
    }
  }

  delay(50);
}
